configuration {
    modi:                       "drun,window,run";
    show-icons:                 true;
    display-drun:               "drun";
    display-run:                "run";
    display-filebrowser:        "files";
    display-window:             "window";
    window-format:              "{w}{c} - {t}";
}

@import                          "colors.rasi"
@import                          "fonts.rasi"

/* MAIN WINDOW */
window {

    /* properties for window widget */
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       400px;
    x-offset:                    0px;
    y-offset:                    0px;
    border-radius:               0px;

    /* properties for all widgets */
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    cursor:                      "default";
    background-color:            transparent;
}

/* MAIN BOX */
mainbox {
    enabled:                     true;
    spacing:                     0px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @foreground;
    background-color:            @background;
    children:                    [ "inputbar", "listview"];
}

/* INPUT BAR */
inputbar {
    enabled:                     true;
    spacing:                     0px;
    margin:                      6px;
    padding:                     0px;
    border:                      0px 0px 0px 0px;
    border-radius:               0px;
    border-color:                @green;
    background-color:            @background;
    text-color:                  @foreground;
    children:                    [ "prompt", "entry" ];
}

prompt {
    enabled:                     true;
    padding:                     10px;
    border-radius:               0px;
    background-color:            @grey;
    text-color:                  @foreground;    
}

textbox-prompt-colon {
    enabled:                     false;
    expand:                      false;
    str:                         "::";
    background-color:            inherit;
    text-color:                  inherit;
}

entry {
    enabled:                     true;
    padding:                     10px;
    background-color:            inherit;
    text-color:                  @grey;
    cursor:                      text;
    placeholder:                 "";
    placeholder-color:           inherit;
}

/* LIST VIEW */
listview {
    enabled:                     true;
    columns:                     1;
    lines:                       10;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    layout:                      vertical;
    reverse:                     false;
    fixed-height:                true;
    fixed-columns:               true;
    
    spacing:                     0px;
    margin:                      0px 6px 6px 6px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @cyan;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      "default";
}
scrollbar {
    handle-width:                5px ;
    handle-color:                @foreground;
    border-radius:               5px;
    background-color:            @background;
}

/* ELEMENTS */
element {
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     4px 10px;
    border:                      0px 0px 1px 0px;
    border-radius:               0px;
    border-color:                @grey;
    background-color:            transparent;
    text-color:                  @foreground;
    cursor:                      pointer;
}

element normal.normal {
    background-color:            @background;
    text-color:                  @grey;
}

element normal.urgent {
    background-color:            @green;
    text-color:                  @foreground;
}

element normal.active {
    background-color:            @cyan;
    text-color:                  @background;
}

element selected.normal {
    background-color:            @grey;
    text-color:                  @blue;
}

element selected.urgent {
    background-color:            @grey;
    text-color:                  @foreground;
}

element selected.active {
    background-color:            @foreground;
    text-color:                  @background;
}

element alternate.normal {
    background-color:            @background;
    text-color:                  @grey;
}

element alternate.urgent {
    background-color:            @red;
    text-color:                  @foreground;
}

element alternate.active {
    background-color:            @green;
    text-color:                  @foreground;
}

element-icon {
    background-color:            transparent;
    text-color:                  inherit;
    size:                        36px;
    cursor:                      inherit;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    highlight:                   inherit;
    cursor:                      inherit;
    vertical-align:              0.5;
    horizontal-align:            0.0;
}

/* MODE SWITCHER */
mode-switcher{
    enabled:                     true;
    spacing:                     10px;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @cyan;
    background-color:            transparent;
    text-color:                  @foreground;
}

button {
    padding:                     10px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @cyan;
    background-color:            @green;
    text-color:                  inherit;
    cursor:                      pointer;
}

button selected {
    background-color:            var(selected-normal-background);
    text-color:                  var(selected-normal-foreground);
}

/* MESSAGE */
message {
    enabled:                     true;
    margin:                      0px;
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px 0px 0px 0px;
    border-color:                @cyan;
    background-color:            transparent;
    text-color:                  @foreground;
}

textbox {
    padding:                     10px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @cyan;
    background-color:            @green;
    text-color:                  @foreground;
    vertical-align:              0.5;
    horizontal-align:            0.0;
    highlight:                   none;
    placeholder-color:           @foreground;
    blink:                       true;
    markup:                      true;
}

error-message {
    padding:                     0px;
    border:                      0px solid;
    border-radius:               0px;
    border-color:                @cyan;
    background-color:            @background;
    text-color:                  @foreground;
}
