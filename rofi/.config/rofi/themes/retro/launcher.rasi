configuration {
    //modi: "drun,run,window";
    show-icons: true;
    display-drun: "drun";
    display-run: "run";
    display-window: "window";
    window-format: "{t}";
}

@theme "~/.config/rofi/themes/assets/carbonfox.rasi"

/* MAIN WINDOW */
window {
    transparency: "real";
    location: center;
    anchor: center;
    width: 400px;

    enabled: true;
    cursor: "default";
}

/* MAIN BOX */
mainbox {
    enabled: true;
    background-color: @background;
    children: [ "inputbar", "listview"];
}

/* INPUT BAR */
inputbar {
    enabled: true;
    margin: 6px;
    background-color: transparent;
    children: [ "prompt", "entry" ];
}

prompt {
    enabled: true;
    padding: 10px;
    background-color: @bright-black;
    border: 2px 0px 0px 2px;
    border-color: @bright-gray;
    text-color: @foreground;    
}

entry {
    enabled: true;
    padding: 10px;
    border: 1px;
    border-color: black;
    background-color: white;
    text-color: @black;
    cursor: text;
    placeholder: "search";
    placeholder-color: @bright-gray;
}

/* LIST VIEW */
listview {
    enabled: true;
    columns: 1;
    lines: 10;
    cycle: true;
    dynamic: false;
    scrollbar: true;
    layout: vertical;
    reverse: false;
    fixed-height: false;
    fixed-columns: false;
    
    margin: 0px 6px 6px 6px;
    border: 0px solid;
    border-color: @cyan;
    background-color: transparent;
    text-color: @foreground;
}

scrollbar {
    handle-width: 5px;
    handle-color: @bright-gray;
    background-color: transparent;
}

/* ELEMENTS */
element {
    enabled: true;
    padding: 4px 10px;
    background-color: transparent;
    text-color: @foreground;
}

element active {
    background-color: @bright-black;
    text-color: @foreground;
}

element selected.normal {
    background-color: @black;
}

element selected.active {
    background-color: @bright-gray;
    text-color: black;
}

element-icon {
    background-color: transparent;
    size: 36px;
}

element-text {
    background-color: transparent;
    text-color: inherit;
    highlight: inherit;
    vertical-align: 0.5;
    horizontal-align: 0.0;
}

/* MESSAGE */
message {
    enabled: true;
    background-color: transparent;
    text-color: @foreground;
}

textbox {
    padding: 10px;
    background-color: @green;
    text-color: @foreground;
    vertical-align: 0.5;
    horizontal-align: 0.0;
    highlight: none;
    placeholder-color: @foreground;
    blink: true;
    markup: true;
}
